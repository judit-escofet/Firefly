400%3B700;fontSize=15;fontColor=#efe6d0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="812" y="461" width="324" height="22" as="geometry"/></mxCell><mxCell id="c206" value="POST /api/profile&lt;br&gt;POST /api/walks → route, share_url&lt;br&gt;POST /api/walks/{id}/location &amp;nbsp;(every 5 s)&lt;br&gt;&amp;nbsp;&amp;nbsp;→ remaining_m · eta_s · off_route_m · near&lt;br&gt;POST /api/walks/{id}/reroute · GET /api/route&lt;br&gt;POST /api/walks/{id}/events &amp;nbsp;alert · duress · arrived&lt;br&gt;&amp;nbsp;&amp;nbsp;→ texts contacts (60 s dedupe)&lt;br&gt;POST /api/walks/{id}/clip → private link (24 h)&lt;br&gt;POST /api/walks/{id}/scores &amp;nbsp;(batched)&lt;br&gt;POST /api/walks/{id}/end · GET /api/geocode&lt;br&gt;GET &amp;nbsp;/api/negotiate &amp;nbsp;(live updates)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;fontSize=11.5;fontColor=#a9b8a0;align=left;verticalAlign=top;spacing=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="776" y="490" width="390" height="248" as="geometry"/></mxCell><mxCell id="c207" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fillColor=#1b2c25;fillOpacity=100;strokeColor=#e0634f;strokeOpacity=45;" vertex="1" parent="1"><mxGeometry x="760" y="758" width="420" height="132" as="geometry"/></mxCell><mxCell id="c208" value="" style="rounded=1;absoluteArcSize=1;arcSize=4;html=1;fillColor=#e0634f;fillOpacity=100;strokeColor=none;strokeOpacity=100;" vertex="1" parent="1"><mxGeometry x="760" y="770" width="4" height="108" as="geometry"/></mxCell><mxCell id="c209" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="776" y="771" width="18" height="18" as="geometry"/></mxCell><mxCell id="c210" value="&lt;b style=&quot;font-size:15px;color:#f7f1e3&quot;&gt;Demo dispatch call&lt;/b&gt;" style="text;html=