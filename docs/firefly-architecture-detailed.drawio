" parent="1"><mxGeometry x="776" y="966" width="18" height="18" as="geometry"/></mxCell><mxCell id="c216" value="Without a database or texting service configured, walks still work: the app plans the route locally and alerts are logged." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Atkinson Hyperlegible;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DAtkinson%2BHyperlegible%3Awght%40400%3B700;fontSize=12;fontColor=#a9b8a0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="802" y="964" width="360" height="56" as="geometry"/></mxCell><mxCell id="c217" value="" style="rounded=1;absoluteArcSize=1;arcSize=48;html=1;fillColor=#111d18;fillOpacity=100;strokeColor=#f6bd55;strokeOpacity=35;" vertex="1" parent="1"><mxGeometry x="1240" y="150" width="520" height="330" as="geometry"/></mxCell><mxCell id="c218" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1260" y="168" width="18" height="18" as="geometry"/></mxCell><mxCell id="c219" value="&lt;b style=&quot;letter-spacing:1.5px&quot;&gt;AI &amp; VOICE&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#869683;letter-spacing:0&quot;&gt;· P1&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Atkinson Hyperlegible;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DAtkinson%2BHyperlegible%3Awght%40400%3B700;fontSize=12.5;fontColor=#f6bd55;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1286" y="168" width="454" height="20" as="geometry"/></mxCell><mxCell id="c220" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;html=1;fillColor=#15231d;fillOpacity=100;strokeColor=#efe6d0;strokeOpacity=10;" vertex="1" parent="1"><mxGeometry x="1260" y="192" width="240" height="50" as="geometry"/></mxCell><mxCell id="c221" value="" style="rounded=1;absoluteArcSize=1;arcSize=18;html=1;fillColor=#15231d;fillOpacity