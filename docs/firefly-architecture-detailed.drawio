1.6;endArrow=block;endFill=1;endSize=6;startArrow=none;fontFamily=Atkinson Hyperlegible;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DAtkinson%2BHyperlegible%3Awght%40400%3B700;fontSize=11;fontStyle=1;fontColor=#efe6d0;labelBackgroundColor=#0c1511;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c462" target="c463"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e469" value="scream · code phrase · distress" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#f6bd55;strokeOpacity=85;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;startArrow=none;fontFamily=Atkinson Hyperlegible;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DAtkinson%2BHyperlegible%3Awght%40400%3B700;fontSize=11;fontStyle=1;fontColor=#efe6d0;labelBackgroundColor=#0c1511;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c461" target="c463"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="185" y="855"/></Array></mxGeometry></mxCell><mxCell id="e470" value="10 s, no PIN · or any wrong code" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#e0634f;strokeOpacity=85;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;startArrow=none;fontFamily=Atkinson Hyperlegible;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DAtkinson%2BHyperlegible%3Awght%40400%3B700;fontSize=11;fontStyle=1;fontColor=#efe6d0;labelBackgroundColor=#0c1511;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c463" target="c464"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e471" value="her PIN" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#86b878;strokeOpacity=85;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;startArrow=none;fontFamily=Atkinson Hyperlegible;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DAtkinson%2BHyperlegible%3Awght%40400%3B700;fontSize=11;fontStyle=1;fontColor=#efe6d0;labelBackgroundColor=#0c1511;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c463" target="c465"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e472" value="after 20 s" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#a9b8a0;strokeOpacity=85;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;startArrow=none;fontFamily=Atkinson Hyperlegible;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DAtkinson%2BHyperlegible%3Awght%40400%3B700;fontSize=11;fontStyle=1;fontColor=#efe6d0;labelBackgroundColor=#0c1511;exitX=0;exitY=0.5;entryX=0.25;entryY=1;" edge="1" parent="1" source="c465" target="c461"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="965"/></Array></mxGeometry></mxCell><mxCell id="e473" value="walk ends" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#a9b8a0;strokeOpacity=85;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;startArrow=none;fontFamily=Atkinson Hyperlegible;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DAtkinson%2BHyperlegible%3Awght%40400%3B700;fontSize=11;fontStyle=1;fontColor=#efe6d0;labelBackgroundColor=#0c1511;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="c464" target="c461"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="975" y="600"/><mxPoint x="185" y="600"/></Array></mxGeometry></mxCell><mxCell id="c474" value="A wrong code during the countdown is the duress PIN: the screen shows the same &quot;All good&quot; as a cancel, but contacts are alerted and the demo dispatcher is called." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Atkinson Hyperlegible;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DAtkinson%2BHyperlegible%3Awght%40400%3B700;fontSize=12;fontColor=#a9b8a0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="700" y="930" width="420" height="64" as="geometry"/></mxCell><mxCell id="c475"