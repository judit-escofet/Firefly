tStyle=1;fontColor=#a9b8a0;labelBackgroundColor=#0c1511;" edge="1" parent="1" source="c478" target="c480"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e485" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#86b878;strokeOpacity=85;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;fontFamily=Atkinson Hyperlegible;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DAtkinson%2BHyperlegible%3Awght%40400%3B700;fontSize=11;fontStyle=1;fontColor=#a9b8a0;labelBackgroundColor=#0c1511;" edge="1" parent="1" source="c480" target="c482"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c486" value="" style="rounded=1;absoluteArcSize=1;arcSize=48;html=1;fillColor=#111d18;fillOpacity=100;strokeColor=#f6bd55;strokeOpacity=35;" vertex="1" parent="1"><mxGeometry x="1160" y="784" width="600" height="228" as="geometry"/></mxCell><mxCell id="c487" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1180" y="802" width="18" height="18" as="geometry"/></mxCell><mxCell id="c488" value="&lt;b style=&quot;letter-spacing:1.5px&quot;&gt;WHO REACTS TO alert.state&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Atkinson Hyperlegible;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DAtkinson%2BHyperlegible%3Awght%40400%3B700;fontSize=12.5;fontColor=#f6bd55;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1206" y="802" width="534" height="20" as="geometry"/></mxCell><mxCell id="c489" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;html=1;fillColor=#1b2c25;fillOpacity=100;strokeColor=#a9b8a0;strokeOpacity=40;" vertex="1" parent="1"><mxGeometry x="1180" y="826" width="560" height="50" as="geometry"/></mxCell><mxCell id="c490" value="&lt;b style=&quot;color:#f7f1e3&quot;&gt;P4 App&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Atkinson Hyperlegible;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DAtkinson%2BHyperlegible%3Awght%40400%3B700;fontSize=13;fontColor=#efe6d0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1196" y="841" width="110" height="20" as="geometry"/></mxCell><mxCell id="c491" value="countdown screen, PIN pad, vibration; identical &quot;All good&quot; for cancel and duress" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Atkinson Hyperlegible;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DAtkinson%2BHyperlegible%3Awght%40400%3B700;fontSize=12;fontColor=#a9b8a0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1306" y="834" width="424" height="36" as="geometry"/></mxCell><mxCell id="c492" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;html=1;fillColor=#1b2c25;fillOpacity=100;strokeColor=#f6bd55;strokeOpacity=40;" vertex="1" parent="1"><mxGeometry x="1180" y="886" width="560" height="50" as="geometry"/></mxCell><mxCell id="c493" value="&lt;b style=&quot;color:#f7f1e3&quot;&gt;P1 Companion&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Atkinson Hyperlegible;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DAtkinson%2BHyperlegible%3Awght%40400%3B700;fontSize=13;fontColor=#efe6d0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1196" y="901" width="110" height="20" as="geometry"/></mxCell><mxCell id="c494" value="switches to calm mode and keeps talking normally; never mentions the alert" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Atkinson Hyperlegible;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DAtkinson%2BHyperlegible%3Awght%40400%3B700;fontSize=12;fontColor=#a9b8a0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1306" y="894" width="424" height="36" as="geometry"/></mxCell><mxCell id="c495" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;html=1;fillColor=#1b2c25;fillOpacity=100;strokeColor=#e9dcc0;strokeOpacity=40;" vertex="1" parent="1"><mxGeometry x="1180" y="946" width="560" height="50" as="geometry"/></mxCell><mxCell id="c496" value="&lt;b style=&quot;color:#f7f1e3&quot;&gt;P3 API&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Atkinson Hyperlegible;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DAtkinson%2BHyperlegible%3Awght%40400%3B700;fontSize=13;fontColor=#efe6d0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1196" y="961" width="110" height="20" as="geometry"/></mxCell><mxCell id="c497" value="texts contacts, tracking page turns red, clip available, demo dispatcher called" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Atkinson Hyperlegible;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DAtkinson%2BHyperlegible%3Awght%40400%3B700;fontSize=12;fontColor=#a9b8a0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1306" y="954" width="424" height="36" as="geometry"/></mxCell><mxCell id="c498" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;html=1;fillColor=#111d18;fillOpacity=100;strokeColor=#f6bd55;strokeOpacity=35;" vertex="1" parent="1"><mxGeometry x="40" y="1032" width="1720" height="46" as="geometry"/></mxCell><mxCell id="c499" value="&lt;b style=&quot;color:#ffe4a6&quot;&gt;Rules&lt;/b&gt; &amp;nbsp;·&amp;nbsp; never call 911 from code &amp;nbsp;·&amp;nbsp; every alert has a 10 s countdown &amp;nbsp;·&amp;nbsp; duress looks identical to cancel &amp;nbsp;·&amp;nbsp; audio leaves the phone only as the 10 s alert clip &amp;nbsp;·&amp;nbsp; scores are numbers, never audio" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Atkinson Hyperlegible;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DAtkinson%2BHyperlegible%3Awght%40400%3B700;fontSize=13;fontColor=#efe6d0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="1046" width="1680" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>