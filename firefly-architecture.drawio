ticalAlign=middle;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="252" y="362" width="170" height="76" as="geometry" /></mxCell><mxCell id="Gu21" value="Last ~12 words&lt;br&gt;Levenshtein ratio ≥ 0.8" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="444" y="362" width="170" height="76" as="geometry" /></mxCell><mxCell id="Gu22" value="&lt;b&gt;danger.signal&lt;/b&gt;&lt;br&gt;source: code_phrase&lt;br&gt;then 30 s cooldown" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="636" y="362" width="184" height="76" as="geometry" /></mxCell><mxCell id="Gu26" value="3 · Check-in triggers (on every position.updated)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=none;strokeColor=#8c8c8c;fontSize=13;align=center;verticalAlign=middle;spacing=6;spacingLeft=8;dashed=1;dashPattern=6 4;fillColor=none;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontColor=#444444;arcSize=3;" vertex="1" parent="1"><mxGeometry x="880" y="320" width="800" height="140" as="geometry" /></mxCell><mxCell id="Gu27" value="position.updated&lt;br&gt;every 5 s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="900" y="362" width="170" height="76" as="geometry" /></mxCell><mxCell id="Gu28" value="long_stop: &amp;lt; 0.3 m/s, 90 s&lt;br&gt;off_route: &amp;gt; 75 m, 30 s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1092" y="362" width="186" height="76" as="geometry" /></mxCell><mxCell id