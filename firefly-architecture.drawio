 parent="1"><mxGeometry x="1450" y="532" width="210" height="74" as="geometry" /></mxCell><mxCell id="Gu51" value="POST /clip → clip_url&lt;br&gt;private Blob · SAS 24 h" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;verticalAlign=middle;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1450" y="628" width="210" height="74" as="geometry" /></mxCell><mxCell id="Gu55" value="Who reacts to alert.state" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=none;strokeColor=#8c8c8c;fontSize=13;align=center;verticalAlign=middle;spacing=6;spacingLeft=8;dashed=1;dashPattern=6 4;fillColor=none;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontColor=#444444;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1180" y="750" width="500" height="260" as="geometry" /></mxCell><mxCell id="Gu56" value="&lt;b&gt;P4 App&lt;/b&gt;: countdown screen, PIN pad, vibration;&lt;br&gt;identical &quot;All good&quot; screen for cancel and duress" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=middle;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1200" y="792" width="460" height="56" as="geometry" /></mxCell><mxCell id="Gu57" value="&lt;b&gt;P1 Companion&lt;/b&gt;: switches to calm mode,&lt;br&gt;keeps talking normally, never mentions the alert" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=middle;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1200" y="864" width="460" height="56" as="geometry" /></mxCell><mxCell id="Gu58" value="&lt;b&gt;P3 API&lt;/b&gt; (via POST /events): texts contacts,&lt;br&gt;tracking page turns red, clip available" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=middle;spacing=6;spacingLeft=8;" vertex="1" parent="1"><